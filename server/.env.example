# ---------- Villager brains (first one set wins) ----------
#   ANTHROPIC_API_KEY → Claude (claude-opus-5)
#   GROQ_API          → Groq (gpt-oss-120b; Stargazer uses gpt-oss-20b for web search)
#   neither           → scripted mock villagers (real tools + approvals, no model)
ANTHROPIC_API_KEY=
GROQ_API=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# MOCK_AGENTS=1      # force scripted villagers (wifi-proof demo backup)

# ---------- Gmail + Google Calendar (Postmaster, Timekeeper) ----------
# console.cloud.google.com → new project → enable "Gmail API" + "Google Calendar API"
# → OAuth consent screen (External; add your Google account as a test user)
# → Credentials → Create OAuth client ID → "Web application"
#   Authorized redirect URI: http://localhost:8787/oauth/google/callback
# Then sign in from the game: build the Post Office, press E, CONNECT GOOGLE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Canvas (Scholar) ----------
# Easiest: paste a token in-game at the Library. Or set it here.
# Canvas → Account → Settings → "+ New Access Token"
# CANVAS_TOKEN=
# CANVAS_BASE_URL=https://wustl.instructure.com

# ---------- Photon Spectrum: villagers text your real phone over iMessage ----------
# app.photon.codes (promo HACKWITHPHOTON) → your project → Settings → Project ID + Secret Key
# (PHOTON_PROJECT_ID / PHOTON_PROJECT_SECRET are accepted too)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Your number in E.164 so the Jade Rabbit can text first, e.g. +13145550123
PLAYER_PHONE=
# Villagers sign emails with this
PLAYER_NAME=
# PHOTON_TERMINAL=1   # Photon's terminal chat for local testing (works with no credentials)

# ---------- Demo helpers ----------
# UNLOCK_ALL=1   # fresh colony starts with every building up (skip the quest chain)
# DEV_TOOLS=1    # allow the "complete current quest" dev command (demo prep / testing)
PORT=8787
