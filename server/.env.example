# ---------- Villager brains (first one set wins) ----------
#   ANTHROPIC_API_KEY → Claude (claude-opus-5)
#   GROQ_API          → Groq (gpt-oss-120b; Stargazer uses gpt-oss-20b for web search)
#   neither           → scripted mock villagers (real tools + approvals, no model)
ANTHROPIC_API_KEY=
GROQ_API=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# MOCK_AGENTS=1      # force scripted villagers (wifi-proof demo backup)

# ---------- The Office (developer building: watch your coding agents) ----------
# The Office shows your Claude Code sessions live (the main session is the team
# lead, each sub-agent a worker at a desk). Nothing to set up: it reads
# ~/.claude/projects on this computer. Point it elsewhere with:
# CLAUDE_PROJECTS_DIR=/path/to/.claude/projects
# Other tools can report agents: POST JSON (content-type: application/json) to http://localhost:8787/agents/event

# ---------- Gmail + Google Calendar (Postmaster, Timekeeper) ----------
# console.cloud.google.com → new project → enable "Gmail API" + "Google Calendar API"
# → OAuth consent screen (External; add your Google account as a test user)
# → Credentials → Create OAuth client ID → "Web application"
#   Authorized redirect URI: http://localhost:8787/oauth/google/callback
# Then sign in from the game: build the Post Office, press E, CONNECT GOOGLE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Canvas (Scholar) ----------
# Easiest: paste a token in-game at the Library. Or set it here.
# Canvas → Account → Settings → "+ New Access Token"
# CANVAS_TOKEN=
# CANVAS_BASE_URL=https://wustl.instructure.com

# ---------- Photon Spectrum: villagers text your real phone over iMessage ----------
# app.photon.codes (promo HACKWITHPHOTON) → your project → Settings → Project ID + Secret Key
# (PHOTON_PROJECT_ID / PHOTON_PROJECT_SECRET are accepted too)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Your number in E.164 so the Jade Rabbit can text first, e.g. +13145550123
PLAYER_PHONE=
# Villagers sign emails with this
PLAYER_NAME=
# PHOTON_TERMINAL=1   # Photon's terminal chat for local testing (works with no credentials)

# ---------- Villager voices (ElevenLabs, free plan works) ----------
# elevenlabs.io → Developers → API Keys. Villagers speak in-person replies aloud;
# every line is cached in server/data/voice, so repeats cost nothing.
# No key (or out of credits) → the browser's built-in voices take over.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5   # half a credit per character (free plan: 10k credits/month)
# BROWSER_VOICES=1                     # keep ElevenLabs off while developing, save the credits for the demo
# VOICE_POSTMASTER=<voice id>          # swap any villager's voice (VOICE_JADE_RABBIT, VOICE_STARGAZER, ...)

# ---------- Demo helpers ----------
# UNLOCK_ALL=1   # fresh colony starts with every building up (skip the quest chain)
# DEV_TOOLS=1    # allow the "complete current quest" dev command (demo prep / testing)
PORT=8787
# The server only answers on this computer (127.0.0.1, and only to localhost/127.0.0.1/[::1]).
# To play from other devices on your network: HOST=0.0.0.0 and list the names they use, e.g.
# ALLOWED_HOSTS=192.168.1.20,my-laptop.local  (accounts, letters and villagers' work stay on this computer's game)
# HOST=127.0.0.1
# ALLOWED_HOSTS=

# ---------- Hosting online (the gateway: `npm run build`, then `npm start`) ----------
# Set these on the host (e.g. Railway), not for the single-player game. See README, Deploying.
# MOON_PUBLIC_URL=https://your-app.up.railway.app   # required
# MOON_DATA_ROOT=/data          # a persistent volume, so villages and accounts survive redeploys
# SESSION_SECRET=               # long random string (else one is kept in MOON_DATA_ROOT)
# MOON_MAX_RUNNING=4            # villages running at once (default 30; 4 fits a 0.5 GB box)
# MOON_IDLE_MIN=5               # minutes before an unused village stops (its save stays)
# MOON_HEAP_MB=128              # each village's V8 old-space cap
# MOON_SEMI_SPACE_MB=1          # each village's V8 young-generation cap
